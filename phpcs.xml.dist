<?xml version="1.0"?>
<ruleset name="WPilot AI Coding Standards">
    <description>WordPress Coding Standards adapted for PSR-4 namespaced PHP 8.2+ plugin classes.</description>

    <file>includes</file>
    <file>wpilot-ai.php</file>
    <file>uninstall.php</file>

    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <rule ref="WordPress-Core">
        <!-- PSR-4 class file naming is used throughout includes/ -->
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="Universal.Operators.DisallowShortTernary.Found"/>
    </rule>

    <rule ref="WordPress-Extra">
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    </rule>

    <rule ref="WordPress.DB.DirectDatabaseQuery"/>
    <rule ref="WordPress.Security.EscapeOutput"/>
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="edit_products"/>
            </property>
        </properties>
    </rule>
</ruleset>
