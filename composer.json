{
  "name": "wpilot-ai/wpilot-ai",
  "description": "Open-source WordPress AI management agent with structured tool calling, Elementor, WooCommerce, SEO, approval diffs, and verified rollback.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "php-stubs/woocommerce-stubs": "^9.0",
    "php-stubs/wordpress-stubs": "^6.7",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^3.10",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "WPilotAI\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WPilotAI\\Tests\\": "tests/phpunit/"
    }
  },
  "scripts": {
    "lint": "find includes tests wpilot-ai.php uninstall.php -type f -name '*.php' -print0 | xargs -0 -n1 php -l",
    "test": "phpunit --configuration phpunit.xml.dist",
    "stan": "phpstan analyse --configuration=phpstan.neon.dist",
    "cs": "phpcs --standard=phpcs.xml.dist"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
